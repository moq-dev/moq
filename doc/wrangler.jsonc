{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "moq-doc",
	"compatibility_date": "2025-12-13",
	"main": "worker.ts",
	"assets": {
		"directory": ".vitepress/dist",
		"binding": "ASSETS",
		// Pages choose their format by `Accept`, so the worker fronts them; the
		// hashed bundles never vary.
		"run_worker_first": ["/*", "!/assets/*"]
	}
}
