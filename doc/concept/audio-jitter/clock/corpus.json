			{ "tracks": ["audio"], "start": 0, "every": 20, "frames": 100, "offsets": [5], "reference": 5 },
			{ "tracks": ["audio"], "start": 2000, "every": 20, "frames": 400, "offsets": [35, 30, 50], "reference": 5 }
		]
	},
	{
		"name": "spike",
		"about": "An outage and the backlog behind it span no whole window, so the reference stays",
		"delay": 60,
		"runs": [
			{ "tracks": ["audio"], "start": 0, "every": 20, "frames": 150, "offsets": [5], "reference": 5 },
			{ "tracks": ["audio"], "start": 4500, "every": 5, "frames": 300, "offsets": [600], "reference": 5 },
			{ "tracks": ["audio"], "start": 6000, "every": 20, "frames": 150, "offsets": [5], "reference": 5 }
		]
	},
	{
		"name": "tracks",
		"about": "Each track's anchor follows its own window, and the reference is the earliest anchor, so it moves fully only once every track has followed",
		"delay": 60,
