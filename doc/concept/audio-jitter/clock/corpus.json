			{ "tracks": ["audio"], "start": 6000, "every": 20, "frames": 1, "offsets": [60], "reference": 60 },
			{ "tracks": ["audio"], "start": 6020, "every": 20, "frames": 50, "offsets": [60], "reference": 60 },
			{ "tracks": ["audio"], "start": 7020, "every": 20, "frames": 1, "offsets": [40], "reference": 40 }
		]
	},
	{
		"name": "shallow",
		"about": "A trail within half the delay leaves the reference where it is",
		"delay": 60,
