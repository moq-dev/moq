#!/usr/bin/env just --justfile
#
# Language-specific recipes for the Python packages under py/. Invoked
# from the repo root as `just py <recipe>` via the `mod py` import.
#
# Two workspace packages:
#   ../      maturin project, sources in moq-ffi/: rs/moq-ffi cdylib + uniffi bindings (dist `moq-ffi`)
#   moq-rs/   pure-python ergonomic wrapper depending on moq-ffi (dist `moq-rs`,
#             import `moq`)

set working-directory := '.'

# The test clock (`moq.testing`). `--features` replaces pyproject's list, so it
# names the software encoder the tests use again.
test_features := "--features testing,openh264"

default:
    just check

# Build moq-ffi (maturin cdylib + bindings) and install the pure-python moq-rs
# wrapper, both editable into the workspace venv. `--no-deps` on the wrapper
# keeps uv from fetching moq-ffi off PyPI; maturin just installed it locally.
# The build gets its own target directory because a cdylib's file name carries
# no feature hash: the test features would otherwise replace the default build
# that the other bindings read from target/debug, even while they read it.
_develop *args:
    cd .. && CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}/py" bash sh/local.sh uv run --no-sync maturin develop --locked --uv {{ args }}
    uv pip install --no-deps -e moq-rs

# Lint + format + editable build + pyright + doc samples + docs. `--no-install-workspace`
# installs the root dev group (ruff, maturin, pyright, pytest) without trying to
# pip-build the workspace members; `_develop` then installs them editable, which
# is also what `build` does, so there is no separate build gate here.
#
# `docs` runs here because a broken autodoc reference otherwise surfaces on Read
# the Docs after the fact. It mocks the native module, so it costs no Rust build.
#
# The build has `test`'s features, so `just check` running both compiles moq-ffi
# once. The release builds compile the default features.

# Lint, type-check, editable-build, check the doc samples, and render the docs.
check:
    uv sync --locked --no-install-workspace
    uv run --no-sync ruff check .
    uv run --no-sync ruff format --check .
    just _develop {{ test_features }}
    uv run --no-sync pyright
    just samples
    just docs

# Check the locked dependencies against PyPI's advisories. Nightly: advisories land without a diff.
# `--isolated` keeps the audit group out of the workspace venv.
audit:
    mkdir -p ../.tmp/py
    uv export --locked --all-groups --no-emit-workspace --no-emit-project --format requirements-txt --quiet -o ../.tmp/py/audit.txt
    uv run --isolated --locked --only-group audit pip-audit --disable-pip --require-hashes -r ../.tmp/py/audit.txt

# Type-check every Python sample in the docs against the installed wrapper.
samples:
    ../sh/py/samples.sh

# Auto-fix lint and formatting issues.
fix:
    uv sync --no-install-workspace
    uv run --no-sync ruff check --fix .
    uv run --no-sync ruff format .

# Run the unit tests, on a build with the test clock (`moq.testing`).
test:
    uv sync --locked --no-install-workspace
    just _develop {{ test_features }}
    bash ../sh/local.sh uv run --no-sync pytest moq-rs/tests/ moq-ffi/tests/

# Local dev build: editable install of moq-ffi (with the cdylib + uniffi

# bindings) and the moq-rs wrapper into the workspace venv.
build:
    uv sync --locked --no-install-workspace
    just _develop

# Run the binding benchmark's Python runner (see bench/README.md) on a release build.
bench:
    uv sync --locked --no-install-workspace
    cd .. && bash sh/local.sh uv run --no-sync maturin develop --locked --uv --release
    uv pip install --no-deps -e moq-rs
    uv run --no-sync python moq-rs/benches/ffi.py

# Build the pure-python moq-rs wrapper sdist + wheel into py/dist (for release).
# moq-ffi is built separately by maturin (see release-py-ffi.yml); the wrapper is

# pure python so it needs no compilation, just a metadata-correct wheel.
package:
    # `uv build` has no --locked, and this is the recipe release-py.yml
    # publishes from, so validate the lock explicitly rather than inheriting it
    # from a sync that never runs here.
    uv lock --check
    rm -rf dist
    uv build --package moq-rs --out-dir dist

# Build the Sphinx API docs for the `moq` wrapper into py/dist/docs. Read the
# Docs builds the same config (see .readthedocs.yaml) and hosts the result. The
# native moq_ffi is mocked (autodoc_mock_imports in docs/conf.py), so this needs
# no Rust build.
docs:
    rm -rf dist/docs moq-rs/docs/api
    uv run --isolated --locked --only-group docs \
        sphinx-build -b html -W --keep-going moq-rs/docs dist/docs
