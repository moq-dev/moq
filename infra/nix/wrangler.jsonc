{
	// Cloudflare Wrangler configuration for the Nix binary cache worker.
	// Serves nix.moq.dev from two private B2 buckets: released packages, kept
	// forever, and CI dev shells, which a lifecycle rule expires. The read-only
	// key for both is a pair of Worker secrets, B2_ACCESS_KEY_ID and
	// B2_SECRET_ACCESS_KEY (`bun wrangler secret put`).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nix-moq-dev",
	"main": "src/worker.ts",
	"compatibility_date": "2025-07-09",
	"account_id": "dd618f5dbd5da77b8296f1613c301f5c",
	"workers_dev": false,
	"route": {
		"pattern": "nix.moq.dev",
		"custom_domain": true
	},
	// Observability: keep console lines (cache read errors) but skip the
	// per-request invocation log, which was about a quarter of the account's
	// Workers Logs volume (503K events in 3 days at about 5 kB each).
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	}
}
