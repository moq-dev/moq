{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "bash -lc 'project_dir=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; exec bash \"$project_dir/.codex/hooks/direnv.sh\"'",
						"statusMessage": "Loading Nix development shell"
					}
				]
			}
		]
	}
}
