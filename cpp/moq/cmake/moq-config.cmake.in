# find_package(moq): the C++ bindings for moq-ffi as the moq::moq target.

@PACKAGE_INIT@

if(NOT TARGET moq::moq)
    find_package(Threads REQUIRED)

    # The prebuilt Rust staticlib, and the system libraries an external linker must add for
    # it, baked in for the platform this package was built for.
    add_library(moq::ffi STATIC IMPORTED)
    set_target_properties(moq::ffi PROPERTIES
        IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@MOQ_FFI_LIB_NAME@"
        INTERFACE_LINK_LIBRARIES "@MOQ_NATIVE_LIBS@;Threads::Threads"
    )

    # The generated bindings compile here, in the consumer's project, so they see the same
    # standard and flags as the code that includes <moq/moq.hpp>.
    add_library(moq_bindings STATIC "@PACKAGE_CMAKE_INSTALL_DATADIR@/moq/moq.cpp")
    target_compile_features(moq_bindings PUBLIC cxx_std_17)
    target_include_directories(moq_bindings PUBLIC "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
    target_link_libraries(moq_bindings PUBLIC moq::ffi)
    add_library(moq::moq ALIAS moq_bindings)
endif()

check_required_components(moq)
