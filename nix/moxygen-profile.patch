+void MoQTestClient::validateEndOfTrack(
+    const ReceiveState& state,
+    const ObjectHeader& header) {
+  // A subscription that runs to the track's end may learn where it ended from
+  // an END_OF_TRACK placed directly after the last object, either inline or
+  // opening the next group. It carries no payload and ticks off nothing.
+  const AbsoluteLocation location{header.group, header.id};
+  const AbsoluteLocation inlineEnd{window_.last.group, window_.last.object + 1};
+  const AbsoluteLocation nextGroup{window_.last.group + 1, 0};
+  if (state.type != ReceivingType::SUBSCRIBE || !window_.endOfTrack ||
+      endOfTrackReceived_ ||
+      (location != inlineEnd && location != nextGroup)) {
+    recordSemanticsFailure(
+        folly::to<std::string>(
+            "Unexpected End of Track at group=",
+            header.group,
+            " id=",
+            header.id,
+            "  Expected group=",
+            nextGroup.group,
+            " id=0 or group=",
+            inlineEnd.group,
+            " id=",
+            inlineEnd.object));
+    return;
+  }
+  endOfTrackReceived_ = true;
 }
 
