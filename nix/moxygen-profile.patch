+// The origin alternates priority by group, but advertises the even-group value
+// as the track's publisher priority. A relay that ranks egress by track
+// priority forwards that value for every group; anything else still fails.
+bool priorityMatches(uint64_t groupID, uint8_t priority) {
+  return priority == publisherPriorityForGroup(groupID) ||
+      priority == kMoQTestPublisherPriority;
+}
