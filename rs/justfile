#!/usr/bin/env just --justfile
#
# Language-specific recipes for the Rust workspace under rs/. Invoked from
# the repo root as `just rs <recipe>` via the `mod rs` import.
#
# The Rust crates form a single workspace whose root Cargo.toml lives at
# the repository root, so these recipes run from the repo root rather than
# from rs/ (cargo resolves paths relative to the workspace root either way).

set working-directory := '..'

# `moq-net-fuzz` is a workspace member only so it shares the root lockfile; libFuzzer
# needs a nightly toolchain and sanitizer flags, so `just rs fuzz` is the one recipe
# that may compile it. Every `--workspace` below therefore carries this, as does
# sh/rs/select.sh, since it cannot read this.
no_fuzz := "--exclude moq-net-fuzz"

default:
    just check

# Default features for the selected packages. The full workspace permutations
# each cost a separate compile, so `features` covers them nightly. No `cargo
# check` pass: clippy is a superset of it, and the two use different rustc
# wrappers, so running both compiles the workspace twice.
#
# A bare `just rs check` is default-members, which skips moq-c, moq-ffi,
# moq-gst, and moq-wasm; pass `--workspace` for all of it.

# Compile, lint, format-check, doc-check, and verify dependency hygiene.
[positional-arguments]
check *args:
    cargo clippy --locked --all-targets "$@" -- -D warnings
    just rs _lint "$@"

# `check` with clippy replaced by the `test` build, whose clippy-driver reports
# the same findings. `build.warnings` turns them into errors without entering
# cargo's fingerprint, so a later plain `test` reuses the artifacts. A
# selection can hold nothing testable (moq-wasm has no host tests).

# Compile, lint, and test in one build, plus everything else `check` verifies.
[positional-arguments]
check-test *args:
    CARGO_BUILD_WARNINGS=deny RUSTC_WORKSPACE_WRAPPER={{ require("clippy-driver") }} cargo nextest run --locked --all-targets --no-tests=pass "$@"
    just rs _lint "$@"

# Everything `check` verifies besides clippy.
[positional-arguments]
_lint *args:
    python3 sh/rs/stats-docs.py
    cargo fmt --all --check
    # quinn-udp keeps quinn's formatting; cargo fmt skips it (see moq-sock's lib.rs).
    rustfmt --edition 2024 --check rs/moq-sock/src/udp/mod.rs
    RUSTDOCFLAGS="-D warnings" cargo doc --locked --no-deps "$@"
    cargo shear
    cargo sort --workspace --check --no-format

# Auto-fix clippy/format/shear/sort.
[positional-arguments]
fix *args:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets "$@"
    cargo fmt --all
    rustfmt --edition 2024 rs/moq-sock/src/udp/mod.rs
    cargo shear --fix
    cargo sort --workspace --no-format

# Like `check`, but only the crates in a changed-file list plus their dependents.
check-changed $LIST:
    sh/rs/select.sh check "$LIST"

# Like `check-test`, but only the crates in a changed-file list plus their dependents.
check-test-changed $LIST:
    sh/rs/select.sh check-test "$LIST"

# Like `fix`, but only the crates in a changed-file list plus their dependents.
fix-changed $LIST:
    sh/rs/select.sh fix "$LIST"

# Like `test`, but only the crates in a changed-file list plus their dependents.
test-changed $LIST:
    sh/rs/select.sh test "$LIST"

# Compile moq-tokio by itself at the feature extremes and with each crypto provider.
tokio-features:
    sh/rs/tokio-features.sh

# Runs the `#[cfg(windows)]` code past the compiler, which the Linux gate
# skips; platform.yml runs it on a Windows runner, scoped like `check-changed`
# so a one-crate PR compiles one crate on these slow runners too. Default
# features, since jemalloc doesn't build on MSVC.

# Compile what the branch changed since BASE on a Windows host, or everything with `--all`.
windows $BASE="":
    sh/rs/platform.sh "$BASE"

# Test the platform-sensitive crates nightly on Windows, independent of the diff.
windows-test:
    just rs test -p moq-auth -p hang -p moq-tokio

# Compile and test the io_uring relay path, which is off the default feature set.
# Linux-only, and the tests below the 6.12 kernel floor skip themselves.
[positional-arguments]
uring *args:
    just rs uring-check "$@"
    cargo nextest run --locked -p moq-uring -p moq-relay --features moq-relay/io-uring --all-targets "$@"
    cargo clippy --locked -p moq-uring -p moq-relay --features moq-relay/io-uring,moq-relay/qlog --all-targets "$@" -- -D warnings
    cargo nextest run --locked -p moq-uring --features qlog --all-targets "$@"

# Compile the io_uring relay path, off the default feature set.
[positional-arguments]
uring-check *args:
    cargo clippy --locked -p moq-uring -p moq-relay --features moq-relay/io-uring --all-targets "$@" -- -D warnings

# The Apple-gated code in moq-video, moq-audio, and moq-sock, which
# platform.yml compiles on a Mac runner alongside `windows`.

# Compile what the branch changed since BASE on a macOS host, or everything with `--all`.
macos $BASE="":
    sh/rs/platform.sh "$BASE"

# Test the platform-sensitive crates nightly on macOS, independent of the diff.
macos-test:
    just rs test -p moq-auth -p hang -p moq-tokio

# Compile and lint the capture feature, which the default check skips.
[positional-arguments]
capture *args:
    cargo clippy --locked -p moq-video -p moq-audio --all-targets --features moq-video/capture,moq-audio/capture "$@" -- -D warnings

# The capture tests drive synthetic devices, so they need no hardware.

# Test the capture feature, which the default test pass skips.
[positional-arguments]
capture-test *args:
    just rs test -p moq-video -p moq-audio --features moq-video/capture,moq-audio/capture "$@"

# Compare SHM and GetImage through production capture on the current X11 display.
x11-bench:
    just rs test --release -p moq-video --no-default-features --features capture -E 'test(x11_capture_workload)' --run-ignored only --no-capture

# Compare RGB conversion allocation separately, without an X server.
x11-rgb-bench:
    just rs test --release -p moq-video --no-default-features --features capture -E 'test(x11_rgb_workload)' --run-ignored only --no-capture

# Use an isolated virtual X server and retain paired measurements for comparison.
x11-bench-ci:
    #!/usr/bin/env bash
    set -euo pipefail
    log="${MOQ_X11_BENCH_LOG:-.scratch/x11-capture-benchmark.log}"
    mkdir -p "$(dirname "$log")"
    {
        git rev-parse HEAD
        rustc --version
        xvfb-run -a -s "-screen 0 1920x1080x24 -nolisten tcp" just rs x11-bench
        just rs x11-rgb-bench
    } 2>&1 | tee "$log"

# moq-video's MediaCodec code is `#[cfg(target_os = "android")]`. Needs an NDK,
# which the dev shell lacks, so android.yml runs it outside Nix. `check` rather
# than a denying clippy: the capture plumbing is dead on a target without a
# capture backend.

# Compile the Android backends, which the host-target check skips, and assert the
# moq-ffi library links logcat: `Log::init` is silent on Android without it.
[positional-arguments]
android *args:
    cargo ndk -t arm64-v8a --platform 26 check --locked -p moq-video --all-targets "$@"
    cargo ndk -t arm64-v8a --platform 26 -o target/android-jni build --locked -p moq-ffi "$@"
    nm -D --undefined-only target/android-jni/arm64-v8a/libmoq_ffi.so | grep -q __android_log_

# moq-wasm's crate root is `#![cfg(target_arch = "wasm32")]`, so only a wasm32
# build sees the code. Not to be confused with `just js wasm`, which builds the
# shippable `@moq/wasm` package. `moq-mux` and `moq-ffi` share the invocation
# because moq-mux needs the getrandom backend only its siblings declare, and
# features unify only within one cargo invocation.

# Compile and lint the browser/WASM bindings, which the host-target check skips.
[positional-arguments]
wasm *args:
    cargo clippy --locked -p moq-wasm -p moq-mux -p moq-ffi --target wasm32-unknown-unknown --lib "$@" -- -D warnings

# Auto-fix the browser/WASM bindings.
[positional-arguments]
wasm-fix *args:
    cargo clippy --locked --fix --allow-staged --allow-dirty -p moq-wasm -p moq-mux -p moq-ffi --target wasm32-unknown-unknown --lib "$@"
    cargo fmt -p moq-wasm -p moq-mux -p moq-ffi

# Audit dependencies against deny.toml. Nightly: advisories land without a diff.
audit:
    cargo deny check --show-stats

# Verify relay startup validation without a QUIC backend.
relay-minimal:
    cargo nextest run --locked -p moq-relay --no-default-features --lib -E 'test(workers_require_a_quic_backend)'

# Outside nextest because the staticlib link alone outlasts its hang budget.

# Compile and run moq-c's C fixtures, and the C doc samples, against libmoq.a. Must run on Unix.
c-tests:
    sh/rs/c-tests.sh

# The feature permutations `check` leaves out, nightly. `--all-features` is the
# only thing that compiles moq-cli's play/capture, the device features, the
# Linux bindgen codecs, PipeWire, and jemalloc; `--no-default-features` the only
# thing that compiles the `#[cfg(not(feature = ...))]` arms.

# Compile the workspace at the feature extremes.
features:
    cargo check --locked --workspace {{ no_fuzz }} --all-targets --no-default-features
    cargo hack check --locked -p moq-tokio --each-feature --exclude-features _transport --features aws-lc-rs
    cargo check --locked -p moq-relay --no-default-features
    just rs relay-minimal
    cargo check --locked -p moq-cli --no-default-features
    cargo check --locked -p moq-bench --no-default-features
    cargo check --locked -p moq-boy --no-default-features
    cargo check --locked -p moq-hls -p moq-rtmp -p moq-rtc --no-default-features --all-targets
    cargo clippy --locked --workspace {{ no_fuzz }} --all-targets --all-features -- -D warnings
    RUSTDOCFLAGS="-D warnings" cargo doc --locked --workspace {{ no_fuzz }} --all-features --no-deps
    cargo nextest run --locked --workspace {{ no_fuzz }} --all-targets --all-features

# Compile the media crates at supported feature boundaries and prove expensive
# native/render dependencies are absent when their features are excluded.
media-features:
    sh/rs/media-features.sh

# nextest kills a wedged test (`.config/nextest.toml` sets the timeout), but
# skips doctests; `just rs doctest` covers those. clippy-driver as the workspace
# wrapper reports lint findings from the same compile, as warnings: `check-test`
# is the gate. It is part of cargo's fingerprint, and RUSTFLAGS would split the
# artifact cache, which is why neither is set any other way.

# Run the test suite, reporting clippy findings from the same compile.
[positional-arguments]
test *args:
    RUSTC_WORKSPACE_WRAPPER="$(command -v clippy-driver || true)" cargo nextest run --locked --all-targets "$@"

# Exercise Vulkan -> CUDA -> NVENC on Linux/NVIDIA hardware.
vulkan-cuda:
    sh/rs/vulkan-cuda.sh

# The media tasks run against a recorder rather than a device (see
# `rs/moq-cli/src/play/fake.rs`), so this needs no speaker or display.

# Test moq-cli's `play` feature, which default features leave out.
[positional-arguments]
play *args:
    just rs test -p moq-cli --features play "$@"

# Compile and run the `/// ```` examples, which nextest skips.
[positional-arguments]
doctest *args:
    cargo test --locked --doc "$@"

# `--cfg loom` swaps kio's primitives for loom's, so it rebuilds the world and
# stays out of `check`. `--release` because a model check runs the body once
# per interleaving (411s -> 51s); the assertions are plain `assert!`. kio's
# models search every interleaving; moq-net's cap preemptions (see
# `tests/loom.rs`, `LOOM_MAX_PREEMPTIONS`). kio's own unit tests are
# `cfg(not(loom))`.

# Permutation-test the concurrent handoffs with loom.
[positional-arguments]
loom *args:
    RUSTFLAGS="--cfg loom" cargo test --locked --release -p kio --lib loom:: "$@"
    RUSTFLAGS="--cfg loom" cargo test --locked --release -p moq-net --test loom "$@"

# Needs nightly and cargo-fuzz; CI replays the corpus on stable through
# moq-net's own tests instead. See rs/moq-net/fuzz/README.md.

# Fuzz the moq-net wire codecs: `just rs fuzz lite -- -max_total_time=300`.
[positional-arguments]
fuzz target *args:
    sh/rs/fuzz.sh "$@"

# Build the default workspace members.
build:
    cargo build --locked

# Run the comparable epoll and io_uring UDP matrices.
[positional-arguments]
bench-udp *args:
    cargo bench -p moq-uring --bench udp_tokio -- "$@"
    cargo bench -p moq-uring --bench udp_uring -- "$@"

# Measure a noq echo through the io_uring worker, ablating receive
# batching, GRO, and GSO one at a time. Linux 6.12+ (skips loudly otherwise).
[positional-arguments]
bench-echo *args:
    cargo bench -p moq-uring --bench echo_noq -- "$@"

# Measure a full moq-lite session (publisher to subscriber) through the
# io_uring worker, same ablations and per-iteration unit as bench-echo.
# Linux 6.12+ (skips loudly otherwise).
[positional-arguments]
bench-session *args:
    cargo bench -p moq-uring --bench session_lite -- "$@"

# Create release PRs and publish crates via release-plz.
release:
    release-plz release-pr --git-token "$GITHUB_TOKEN"
    release-plz release --git-token "$GITHUB_TOKEN"

# Build a .deb or .rpm locally: `just rs package moq-relay deb`.
package crate packager:
    sh/rs/package.sh {{ crate }} {{ packager }}

# Build and package a workspace binary as a release tarball.
[positional-arguments]
package-binary *args:
    sh/rs/package-binary.sh "$@"

# Build and package a workspace binary as a Windows .zip.
[positional-arguments]
package-windows *args:
    sh/rs/package-windows.sh "$@"

# Render an nfpm config from the environment and build a .deb or .rpm: CONFIG PACKAGER OUTPUT.
[positional-arguments]
package-nfpm *args:
    sh/rs/package-nfpm.sh "$@"

# Build and package the moq-ffi native libraries, or only its bindings.
[positional-arguments]
package-ffi *args:
    rs/moq-ffi/build.sh "$@"

# Build and package moq-c.
[positional-arguments]
package-moq-c *args:
    rs/moq-c/build.sh "$@"

# Build and package the moq-gst GStreamer plugin.
[positional-arguments]
package-gst *args:
    rs/moq-gst/build.sh "$@"

# Load a packaged moq-gst plugin into the host's GStreamer and find its elements.
[positional-arguments]
gst-smoke *args:
    rs/moq-gst/smoke.sh "$@"

# Device-free mixer cost, swept over sink count and frames per callback.
bench-playback:
    cargo nextest run --locked --release -p moq-audio --features playback --run-ignored only -E 'test(benchmark_mixer_callbacks)' --success-output immediate

# Sweep retained RTMP chunk-stream IDs independently of message and chunk sizes.
[positional-arguments]
bench-rtmp *args:
    cargo bench --locked -p moq-rtmp --bench chunk_interleaving -- "$@"
