# Build the Criterion benches CodSpeed simulates; CI runs them with `cargo codspeed run`.
# Only single-threaded benches without I/O, whose instruction counts repeat. CodSpeed skips
# `iter_custom`, so targets made only of it are left out too. Nightly still measures them all.
codspeed:
    cargo codspeed build --locked -m simulation \
        -p kio -p moq-audio -p moq-e2ee -p moq-json -p moq-mux -p moq-net -p moq-pattern -p moq-quic -p moq-rtmp \
        --features moq-audio/bus,moq-net/fuzz,moq-quic/fuzz \
        --bench tasks --bench waiter --bench bus --bench protect --bench codec --bench table \
        --bench catalog --bench containers --bench decode_clock --bench export --bench jitter \
        --bench parameter_sets --bench ts_programs --bench ts_schedule --bench ts_video \
        --bench announce --bench auth --bench bandwidth --bench canonical --bench frame --bench interests \
        --bench priority --bench retirement --bench schedule --bench stats --bench synced --bench tail \
        --bench tracks --bench varint --bench viewers --bench matching \
        --bench endpoint --bench receive --bench sent_packets --bench streams --bench chunk_interleaving

# Held feed FETCH readiness across independent request and track counts.
[positional-arguments]
bench-feed-fetch *args:
    bash sh/rs/nextest.sh cargo nextest run --locked --release -p moq-net --lib --run-ignored only -E 'test(benchmark_feed_fetch_wakes)' --success-output immediate "$@"

# Device-free mixer and resampler cost, swept over fanout, packetization, and layout.
bench-playback:
    bash sh/rs/nextest.sh cargo nextest run --locked --release -p moq-audio --features playback --run-ignored only -E 'test(benchmark_mixer_callbacks) | test(benchmark_resampler)' --success-output immediate

# Sweep retained RTMP chunk-stream IDs independently of message and chunk sizes.
[positional-arguments]
bench-rtmp *args:
    bash sh/local.sh cargo bench --locked -p moq-rtmp --bench chunk_interleaving -- "$@"

# Refresh one credential across unrelated sessions and held token counts.
[positional-arguments]
bench-relay-auth *args:
    bash sh/local.sh cargo bench --locked -p moq-relay --bench auth -- "$@"

# One relay's stats tick, plus the decode and aggregate tables. `--test` runs each tick once; the tables ignore it and print every configuration.
[positional-arguments]
bench-stats *args:
    bash sh/local.sh cargo bench --locked -p moq-stats --features bench --bench producer_tick --bench decode --bench aggregate -- "$@"

# Sweep latency observations against writer count and report density.
bench-latency:
    bash sh/rs/nextest.sh cargo nextest run --locked --release -p moq-bench --run-ignored only -E 'test(benchmark_observation_contention)' --success-output immediate

# Exact TS receiver scheduling across PID and queued-unit fanout.
[positional-arguments]
bench-ts-schedule *args:
    bash sh/local.sh cargo bench --locked -p moq-mux --bench ts_schedule -- "$@"

# Ingest an MPTS across program count, bitrate and stray PIDs, the strays against null packets that skip the accounting.
[positional-arguments]
bench-ts-programs *args:
    cargo bench --locked -p moq-mux --bench ts_programs -- "$@"

# Sweep container export tracks and queued frames independently.
[positional-arguments]
bench-export *args:
    bash sh/local.sh cargo bench --locked -p moq-mux --bench export -- "$@"

# Requested-pad catalog gating and resolved EOS lookup across renditions x touched pads.
[positional-arguments]
bench-gst-catalog *args:
    bash sh/local.sh cargo bench -p moq-gst --bench catalog "$@"
