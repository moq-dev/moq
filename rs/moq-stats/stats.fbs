// The FlatBuffers flavor of the moq-stats tracks (`<name>.fb.z`).
//
// Each frame is one TrafficFrame (publisher and subscriber tracks) or one
// SessionsFrame (sessions tracks), inflated from the group's shared DEFLATE
// window. Every frame is a full snapshot: a reader inflates the frames of the
// group it joined, in order, and keeps the newest.
//
// This schema is the wire contract. Fields are only ever appended, never
// removed, reordered, or retyped, so an older reader skips what it does not
// know and a newer reader sees an absent field as zero. The per-broadcast
// client-stats extension lands as the next field of TrafficEntry.
//
// Regenerate the Rust code in src/fbs.rs after an edit:
// MOQ_STATS_BLESS=1 cargo test -p moq-stats fbs_is_current

namespace moq.stats;

/// Payload-volume counters for content with one delivery outcome.
table Content {
  bytes: uint64;
  frames: uint64;
  groups: uint64;
  datagrams: uint64;
}

/// Cumulative traffic counters for one broadcast on one tier and role.
table Traffic {
  announces_started: uint64;
  announces_ended: uint64;
  announced_bytes: uint64;
  broadcasts_started: uint64;
  broadcasts_ended: uint64;
  subscriptions_started: uint64;
  subscriptions_ended: uint64;
  fetches: uint64;
  bytes: uint64;
  frames: uint64;
  groups: uint64;
  datagrams: uint64;
  /// Content skipped because it aged past a subscriber's latency budget.
  stale: Content;
}

/// Cumulative connects and disconnects for one auth root on one tier.
table Presence {
  sessions_started: uint64;
  sessions_ended: uint64;
}

/// One broadcast's counters, keyed by its path.
table TrafficEntry {
  path: string (required);
  traffic: Traffic (required);
}

/// One auth root's session gauge, keyed by the root.
table SessionsEntry {
  root: string (required);
  presence: Presence (required);
}

/// A frame of a publisher or subscriber track, sorted by path.
table TrafficFrame {
  entries: [TrafficEntry] (required);
}

/// A frame of a sessions track, sorted by root.
table SessionsFrame {
  entries: [SessionsEntry] (required);
}

root_type TrafficFrame;
