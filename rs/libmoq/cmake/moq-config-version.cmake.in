# moq CMake version file

set(PACKAGE_VERSION "@VERSION@")

# libmoq is 0.x: a minor release may break the API (see MIGRATE.md), so only
# the same major.minor line is compatible, and only if it is at least as new as
# the request. This matches the SameMinorVersion policy that
# write_basic_package_version_file() applies to the source-built package.
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
    if(PACKAGE_VERSION MATCHES "^([0-9]+)\\.([0-9]+)")
        if(PACKAGE_FIND_VERSION_MAJOR STREQUAL "${CMAKE_MATCH_1}"
            AND PACKAGE_FIND_VERSION_MINOR STREQUAL "${CMAKE_MATCH_2}")
            set(PACKAGE_VERSION_COMPATIBLE TRUE)
        endif()
    endif()
    # find_package(moq 0.22...<0.23): PACKAGE_FIND_VERSION is the lower bound,
    # so the upper one is checked here.
    if(PACKAGE_VERSION_COMPATIBLE AND PACKAGE_FIND_VERSION_RANGE)
        if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE")
            if(PACKAGE_VERSION VERSION_GREATER PACKAGE_FIND_VERSION_MAX)
                set(PACKAGE_VERSION_COMPATIBLE FALSE)
            endif()
        elseif(PACKAGE_VERSION VERSION_GREATER_EQUAL PACKAGE_FIND_VERSION_MAX)
            set(PACKAGE_VERSION_COMPATIBLE FALSE)
        endif()
    endif()
    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
