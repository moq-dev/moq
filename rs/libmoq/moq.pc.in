# Paths are relative to this .pc file, in the install layout the release
# tarballs and nix/overlay.nix ship: lib/{libmoq.a,pkgconfig/moq.pc} and
# include/moq.h under one prefix.
libdir=${pcfiledir}/..
includedir=${pcfiledir}/../../include

Name: moq
Description: Media over QUIC C Interface
Version: @VERSION@
Libs: -L${libdir} -lmoq
Libs.private: @LIBS_PRIVATE@
Cflags: -I${includedir}
