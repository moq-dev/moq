node_modules/
target/
dist/
out/
pkg/
.direnv/
.terraform/
# Nix out-links (js/libav keeps one as a GC root) point into the read-only store.
result
**/CHANGELOG.md

# API reports, generated by `just fix` and checked by `just check`.
js/*/api/*.api.md

# IETF drafts are kramdown-rfc markdown, not CommonMark; linted by `just
# drafts check` (kramdown-rfc) instead. doc/draft/ is generated from them by
# doc/.vitepress/drafts.ts.
drafts/draft-*.md
doc/draft/

# The JS API reference, generated by doc/.vitepress/api/ from TSDoc.
doc/lib/js/api/

# Quests use a constrained Markdown dialect checked by the quest validator.
quest/

# Skills are the stubs `quest init` installs; remark would rewrite them (and
# follow .agents, Codex's link to the same directory).
.claude/skills/
.agents/
