set working-directory := '..'

# Build and publish the development environment and @moq/libav to nix.moq.dev.
cache:
    bash sh/gh/cache.sh

# Publish Smoke's runtime packages and their build artifacts to nix.moq.dev.
cache-runtime:
    bash sh/gh/cache-runtime.sh

# Print the newest main commit whose Cache push run succeeded: its closures are all on nix.moq.dev.
cache-rev:
    #!/usr/bin/env bash
    set -euo pipefail
    rev=$(gh run list --repo moq-dev/moq --workflow cache.yml --branch main --event push \
        --status success --limit 1 --json headSha --jq '.[0].headSha // empty')
    if [[ -z "$rev" ]]; then
        echo "no successful Cache run found on main" >&2
        exit 1
    fi
    echo "$rev"

# Build the runner image with a temporary policy on a disposable hosted runner.
runner-vm-ci:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${GITHUB_ACTIONS:-}" != true || "${RUNNER_ENVIRONMENT:-}" != github-hosted ]]; then
        echo "runner-vm-ci requires a disposable GitHub-hosted runner" >&2
        exit 1
    fi
    profile="$(nix build --no-link --print-out-paths .#runner-userns-profile)"
    sudo apparmor_parser --add "$profile"
    trap 'sudo apparmor_parser --remove "$profile"' EXIT
    just gh runner-vm

# Install the persistent host profile that lets Nix store unshare map user namespaces.
runner-userns:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
        echo "runner-userns is persistent host policy; a hosted runner uses runner-vm-ci" >&2
        exit 1
    fi
    sudo install -m 0644 nix/runner/nix-builder-unshare /etc/apparmor.d/nix-builder-unshare
    sudo apparmor_parser --replace /etc/apparmor.d/nix-builder-unshare

# Build and test the persistent NixOS runner VM on x86_64 Linux.
runner-vm:
    bash sh/local.sh nix build --no-link .#checks.x86_64-linux.github-runner-vm .#checks.x86_64-linux.github-runner-vm-image .#checks.x86_64-linux.github-runner-vm-config --print-build-logs

# Lint GitHub Actions workflows, their security, their alert coverage, that every step runs a recipe, and that every opt-in test has a caller.
check:
    python3 sh/version.py
    actionlint
    zizmor --offline --quiet .github
    sh/gh/alert.sh check-coverage
    bun test ./sh/gh/alert.test.ts
    bun sh/gh/check-runs.ts
    python3 sh/gh/test-inventory.py
    python3 bench/relay.test.py

