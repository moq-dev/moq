    python3 sh/rs/test-lints.test.py
    python3 sh/gh/nightly.test.py
    python3 sh/gh/pages-clean.test.py
    python3 sh/gh/bench-report.test.py
    python3 sh/gh/ts-paths.test.py
    sh/go/publish-wrapper.test.sh
    bash .claude/hooks/direnv.test.sh
    python3 sh/rs/uring.test.py

# Release workflow helpers, e.g. `just gh release parse-version moq-cli`.
[positional-arguments]
release *args:
    sh/gh/release.sh "$@"

# Post a failed run to Discord, or check cron and publishing alert coverage.
[positional-arguments]
alert *args:
    sh/gh/alert.sh "$@"

# Render a Homebrew formula template for a release.
[positional-arguments]
formula *args:
    sh/gh/render-formula.sh "$@"

# Copy a rendered formula into a Homebrew tap checkout, migrating renamed formulae.
[positional-arguments]
install-formula *args:
    python3 sh/gh/install-formula.py "$@"

# Trigger the apt-repo and rpm-repo workflows for a release tag.
[positional-arguments]
trigger-repo-publish *args:
    sh/gh/trigger-repo-publish.sh "$@"

# Measure a workflow run's release uploads, the minimal FFI build, and bundled first-load JS entries.
size-collect output run="":
    sh/size/collect.sh '{{ output }}' '{{ run }}'

# Compare a size report with its retained nightly history.
[positional-arguments]
size-report *args:
    python3 sh/size/report.py "$@"

# Collect and compare nightly shipping sizes through the existing alert path.
size-nightly output run:
    sh/size/nightly.sh '{{ output }}' '{{ run }}'

# Install the rendered GStreamer formula against the current macOS tarball.
[positional-arguments]
gst-formula *args:
    python3 sh/gh/gst-formula.py "$@"

# Run related Nightly benchmarks in one build environment, reporting every failure.
nightly group:
    sh/gh/nightly.sh {{ quote(group) }}

# Measure selected Criterion targets through the existing benchmark lifecycle.
[positional-arguments]
criterion *args:
    bench/run.sh --criterion "$@"

# Convert, validate, and stage nightly benchmark history.
[positional-arguments]
benchmark-report *args:
    python3 sh/gh/bench-report.py "$@"

# Select shared native artifacts or check an upstream FFI publisher.
[positional-arguments]
ffi *args:
    python3 sh/gh/ffi.py "$@"

# Prepare the shared history branch or publish its regression table.
[positional-arguments]
benchmark-publish *args:
    sh/gh/bench-publish.sh "$@"

# Commit a built report to gh-pages under one directory, leaving the branch checked out for the deploy.
pages-publish directory report site:
    sh/gh/pages-publish.sh {{ quote(directory) }} {{ quote(report) }} {{ quote(site) }}

# Delete this run's Pages artifact before uploading a replacement on a rerun.
pages-clean:
    sh/gh/pages-clean.sh
