set working-directory := '..'

# Build and publish the development environment and @moq/libav to nix.moq.dev.
cache:
    bash sh/gh/cache.sh

# Publish the packages Smoke and deploys pin, and their build artifacts, to nix.moq.dev.
cache-runtime:
    bash sh/gh/cache-runtime.sh

# Print the newest main commit whose Cache push run succeeded: its closures are all on nix.moq.dev.
cache-rev:
    #!/usr/bin/env bash
    set -euo pipefail
    rev=$(gh run list --repo moq-dev/moq --workflow cache.yml --branch main --event push \
        --status success --limit 1 --json headSha --jq '.[0].headSha // empty')
    if [[ -z "$rev" ]]; then
        echo "no successful Cache run found on main" >&2
        exit 1
    fi
    echo "$rev"

# Build the runner image with a temporary policy on a disposable hosted runner.
runner-vm-ci:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${GITHUB_ACTIONS:-}" != true || "${RUNNER_ENVIRONMENT:-}" != github-hosted ]]; then
        echo "runner-vm-ci requires a disposable GitHub-hosted runner" >&2
        exit 1
    fi
    profile="$(nix build --no-link --print-out-paths .#runner-userns-profile)"
    sudo apparmor_parser --add "$profile"
    trap 'sudo apparmor_parser --remove "$profile"' EXIT
    just gh runner-vm

# Install the persistent host profile that lets Nix store unshare map user namespaces.
runner-userns:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
        echo "runner-userns is persistent host policy; a hosted runner uses runner-vm-ci" >&2
        exit 1
    fi
    sudo install -m 0644 nix/runner/nix-builder-unshare /etc/apparmor.d/nix-builder-unshare
    sudo apparmor_parser --replace /etc/apparmor.d/nix-builder-unshare

# Build and test the persistent NixOS runner VM on x86_64 Linux.
runner-vm:
    bash sh/local.sh nix build --no-link .#checks.x86_64-linux.github-runner-vm .#checks.x86_64-linux.github-runner-vm-image .#checks.x86_64-linux.github-runner-vm-config --print-build-logs

# Lint GitHub Actions workflows, their security, their alert coverage, that every step runs a recipe, that every opt-in test has a caller, that every benchmark test Nightly filters on still exists in the Rust sources, and that the gate's Rust scope covers every file the Rust sources read outside rs/.
check:
    #!/usr/bin/env bash
    set -euo pipefail
    run() { "$@" || { echo "error: $* failed" >&2; return 1; }; }
    pids=()
    run python3 sh/version.py & pids+=($!)
    run actionlint & pids+=($!)
    run zizmor --offline --quiet .github & pids+=($!)
    run sh/gh/alert.sh check-coverage & pids+=($!)
    run bun test ./sh/gh/alert.test.ts & pids+=($!)
    run bun sh/gh/check-runs.ts & pids+=($!)
    run python3 sh/gh/test-inventory.py & pids+=($!)
    run python3 bench/relay.test.py & pids+=($!)
    run python3 sh/gh/nightly.test.py NightlyTest.test_every_nightly_benchmark_test_exists & pids+=($!)
    run python3 sh/rs/select.test.py SelectTest.test_dispatch_scope_covers_rust_reads & pids+=($!)
    fail=0
    for pid in "${pids[@]}"; do wait "$pid" || fail=1; done
    exit "$fail"

# Repository tooling tests; the merge gate runs every ordinary test file whole when tooling changes.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    max=${CHECK_TOOLING_JOBS:-8}
    if ! [[ $max =~ ^[1-9][0-9]*$ ]]; then
        echo "error: CHECK_TOOLING_JOBS must be a positive integer, got '$max'" >&2
        exit 1
    fi
    pids=()
    fail=0
    run() { "$@" || { echo "error: $* failed" >&2; return 1; }; }
    slot() {
        while (( $(jobs -pr | wc -l) >= max )); do
            wait -n || fail=1
        done
    }
    slot; run python3 sh/version.test.py & pids+=($!)
    slot; run python3 sh/local.test.py & pids+=($!)
    slot; run python3 test/smoke/runner.test.py & pids+=($!)
    slot; run python3 sh/coverage.test.py & pids+=($!)
    slot; run python3 sh/size/report.test.py & pids+=($!)
    slot; run python3 sh/size/release.test.py & pids+=($!)
    slot; run python3 sh/size/nightly.test.py & pids+=($!)
    slot; run python3 bench/compare.test.py & pids+=($!)
    slot; run python3 bench/summary.test.py & pids+=($!)
    slot; run python3 bench/profile.test.py & pids+=($!)
    slot; run python3 bench/fanout.test.py & pids+=($!)
    slot; run python3 bench/lock.test.py & pids+=($!)
    slot; run python3 bench/local.test.py & pids+=($!)
    slot; run python3 sh/gh/gst-formula.test.py & pids+=($!)
    slot; run python3 sh/changed.test.py & pids+=($!)
    slot; run python3 sh/large-files.test.py & pids+=($!)
    slot; run python3 sh/migrate.test.py & pids+=($!)
    slot; run python3 sh/text.test.py & pids+=($!)
    slot; run python3 sh/coverage-tables.test.py & pids+=($!)
    slot; run python3 sh/tlc.test.py & pids+=($!)
    slot; run python3 sh/tla.test.py & pids+=($!)
    slot; run python3 sh/dispatch-query.test.py & pids+=($!)
    slot; run python3 sh/gh/test-inventory.test.py & pids+=($!)
    slot; run bun test ./sh/gh/remeasure.test.ts & pids+=($!)
    slot; run bun test ./sh/gh/setup.test.ts & pids+=($!)
    slot; run bun sh/gh/queue.test.ts & pids+=($!)
    slot; run python3 sh/gh/install-formula.test.py & pids+=($!)
    slot; run sh/gh/release.test.sh & pids+=($!)
    slot; run python3 sh/gh/ffi.test.py & pids+=($!)
    slot; run bun test ./sh/gh/ffi.test.ts ./sh/gh/cpp.test.ts ./sh/gh/publish.test.ts & pids+=($!)
    slot; run python3 sh/rs/package-rename.test.py & pids+=($!)
    slot; run python3 sh/dart/build.test.py & pids+=($!)
    slot; run python3 sh/kt/gradle.test.py & pids+=($!)
    slot; run python3 sh/rs/select.test.py & pids+=($!)
    slot; run python3 sh/rs/config.test.py & pids+=($!)
    slot; run python3 sh/rs/hakari.test.py & pids+=($!)
    slot; run python3 sh/rs/test-lints.test.py & pids+=($!)
    slot; run python3 sh/js/install.test.py & pids+=($!)
    slot; run python3 sh/js/workspace.test.py & pids+=($!)
    slot; run python3 sh/js/audit.test.py & pids+=($!)
    slot; run python3 sh/gh/nightly.test.py & pids+=($!)
    slot; run python3 sh/gh/pages-clean.test.py & pids+=($!)
    slot; run python3 sh/gh/bench-report.test.py & pids+=($!)
    slot; run sh/go/publish-wrapper.test.sh & pids+=($!)
    for pid in "${pids[@]}"; do wait "$pid" || fail=1; done
    exit "$fail"

# Tooling integration tests and selector timing, run nightly outside the merge gate.
test-integration:
    bash sh/local.sh python3 bench/build.slow.test.py
    python3 sh/dispatch-query.test.py --bench

# Have Maven Central's Portal validate a Maven repository with a rust2 checkout's ffi/release/central.sh, then drop it unpublished.
[positional-arguments]
central-check rust2 repo:
    "$1/ffi/release/central.sh" validate "$2"

# Release workflow helpers, e.g. `just gh release parse-version moq-cli`.
[positional-arguments]
release *args:
    sh/gh/release.sh "$@"

# Post a failed run to Discord, or check cron and publishing alert coverage.
[positional-arguments]
alert *args:
    sh/gh/alert.sh "$@"

# Render a Homebrew formula template for a release.
[positional-arguments]
formula *args:
    sh/gh/render-formula.sh "$@"

# Copy a rendered formula into a Homebrew tap checkout, migrating renamed formulae.
[positional-arguments]
install-formula *args:
    python3 sh/gh/install-formula.py "$@"

# Trigger the apt-repo and rpm-repo workflows for a release tag.
[positional-arguments]
trigger-repo-publish *args:
    sh/gh/trigger-repo-publish.sh "$@"

# Measure a workflow run's release uploads and bundled first-load JS entries.
size-collect output run="":
    sh/size/collect.sh '{{ output }}' '{{ run }}'

# Compare a size report with its retained nightly history.
[positional-arguments]
size-report *args:
    python3 sh/size/report.py "$@"

# Collect and compare nightly shipping sizes through the existing alert path.
size-nightly output run:
    sh/size/nightly.sh '{{ output }}' '{{ run }}'

# Run a command against Ubuntu's GStreamer in the pinned gstreamer-ci image (Linux).
[positional-arguments]
gstreamer *args:
    sh/gh/gstreamer.sh "$@"

# Install the rendered GStreamer formula against the current macOS tarball.
[positional-arguments]
gst-formula *args:
    python3 sh/gh/gst-formula.py "$@"

# Run related Nightly benchmarks in one build environment, reporting every failure.
nightly group:
    sh/gh/nightly.sh {{ quote(group) }}

# Measure selected Criterion targets through the existing benchmark lifecycle.
[positional-arguments]
criterion *args:
    bench/run.sh --criterion "$@"

# Convert, validate, and stage nightly benchmark history.
[positional-arguments]
benchmark-report *args:
    python3 sh/gh/bench-report.py "$@"

# Select shared native artifacts or check an upstream FFI publisher.
[positional-arguments]
ffi *args:
    python3 sh/gh/ffi.py "$@"

# Prepare the shared history branch or publish its regression table.
[positional-arguments]
benchmark-publish *args:
    sh/gh/bench-publish.sh "$@"

# Commit a built report to gh-pages under one directory, leaving the branch checked out for the deploy.
pages-publish directory report site:
    sh/gh/pages-publish.sh {{ quote(directory) }} {{ quote(report) }} {{ quote(site) }}

# Delete this run's Pages artifact before uploading a replacement on a rerun.
pages-clean:
    sh/gh/pages-clean.sh

# Re-measure stale planned-break pins and prepare their release update PR.
remeasure:
    bun sh/gh/remeasure.ts
