    python3 bench/compare.test.py
    python3 bench/summary.test.py
    python3 bench/profile.test.py
    python3 sh/gh/gst-formula.test.py
    python3 sh/changed.test.py
    python3 sh/large-files.test.py
    python3 sh/dispatch-query.test.py
    python3 sh/dispatch-query.test.py --bench
    bun test sh/gh/setup.test.ts
    bun sh/gh/queue.test.ts
    python3 sh/gh/install-formula.test.py
    sh/gh/release.test.sh
    python3 sh/gh/ffi.test.py
    bun test sh/gh/ffi.test.ts sh/gh/cpp.test.ts
    python3 sh/rs/package-rename.test.py
    python3 sh/dart/build.test.py
    python3 sh/rs/select.test.py
    python3 sh/rs/config.test.py
    python3 sh/js/workspace.test.py
