# drill: interrupted_publisher_republishes_new_content::loopback
# expect: the interrupted publisher: no announcement change
#
# Removes the relay's withdrawal of a publisher it lost. Each announced route
# holds an origin handle whose drop retracts it; wrapping that in `ManuallyDrop`
# means a route outlives the session that announced it, so a crashed publisher's
# name stays announced with nothing behind it. Explicit withdrawals still consume
# the handle, so only the implicit retraction on session loss is removed.
diff --git a/rs/moq-net/src/lite/subscriber.rs b/rs/moq-net/src/lite/subscriber.rs
--- a/rs/moq-net/src/lite/subscriber.rs
+++ b/rs/moq-net/src/lite/subscriber.rs
@@ -7730,7 +7730,7 @@ impl Announced {
 		let in_place = predecessor == Some(&path);
 		// An error means the prefix is outside our origin's scope, so don't serve it.
 		let predecessor = predecessor.and_then(|previous| match self.routes.get(previous)? {
-			Held::Attached(attached) => Some(&attached.dynamic),
+			Held::Attached(attached) => Some(&*attached.dynamic),
 			_ => None,
 		});
 		match subscriber.origin.forward(&path, route.clone(), predecessor) {
@@ -7819,7 +7819,7 @@ impl Announced {
 		};
 		self.held.pop();
 		if let Held::Attached(entry) = held {
-			entry.dynamic.withdrawn();
+			std::mem::ManuallyDrop::into_inner(entry.dynamic).withdrawn();
 		}
 	}
 
@@ -7921,7 +7921,8 @@ struct AnnouncedRoute {
 	/// without recomputing the chain.
 	route: crate::origin::RouteInfo,
 	/// Dropping it retracts the route and rejects its queued requests.
-	dynamic: crate::origin::Route,
+	// MUTATION: never dropped, so a route outlives the session that announced it.
+	dynamic: std::mem::ManuallyDrop<crate::origin::Route>,
 	/// Closes as the route goes, which closes every source it minted.
 	live: kio::Producer<()>,
 	/// Whether the GOAWAY drain already re-priced this route.
@@ -7941,7 +7942,7 @@ impl AnnouncedRoute {
 	) -> Self {
 		Self {
 			route,
-			dynamic,
+			dynamic: std::mem::ManuallyDrop::new(dynamic),
 			live: Default::default(),
 			drained: false,
 			waker: std::task::Waker::from(wake.clone()),
