# drill: interrupted_publisher_republishes_new_content::loopback
# expect: the interrupted publisher: no announcement change
#
# Removes the relay's withdrawal of a publisher it lost. Each announced route
# holds an origin handle whose drop retracts it; wrapping that in `ManuallyDrop`
# means a route outlives the session that announced it, so a crashed publisher's
# name stays announced with nothing behind it, and a copy the route node lets go
# of without its publisher ending it is leaked rather than retired. Explicit
# withdrawals still consume the handle, so only the implicit retraction on
# session loss is removed.
diff --git a/rs/moq-net/src/lite/subscriber.rs b/rs/moq-net/src/lite/subscriber.rs
--- a/rs/moq-net/src/lite/subscriber.rs
+++ b/rs/moq-net/src/lite/subscriber.rs
@@ -10472,7 +10472,7 @@ impl Announced {
 		};
 		self.held.pop();
 		if let Held::Attached(entry) = held {
-			entry.dynamic.withdrawn();
+			std::mem::ManuallyDrop::into_inner(entry.dynamic).withdrawn();
 		}
 	}
 
@@ -10558,7 +10558,7 @@ fn mint_sources<K: Clone + Send + Sync + 'static>(
 		let validity = if subscriber.version.has_identity() {
 			Default::default()
 		} else {
-			crate::model::broadcast::RequestValidity::for_source(&entry.dynamic, request.path())
+			crate::model::broadcast::RequestValidity::for_source(&*entry.dynamic, request.path())
 		};
 		let source = subscriber.origin.create_source(path.clone(), validity);
 		// A metadata reader gets a copy of its own, filled by a metadata subscription.
@@ -10586,7 +10586,8 @@ struct AnnouncedRoute<K = Path> {
 	/// without recomputing the chain.
 	route: crate::origin::RouteInfo,
 	/// Dropping it retracts the route and rejects its queued requests.
-	dynamic: crate::origin::Claim,
+	// MUTATION: never dropped, so a route outlives the session that announced it.
+	dynamic: std::mem::ManuallyDrop<crate::origin::Claim>,
 	/// Closes as the route goes, which closes every source it minted.
 	live: kio::Producer<()>,
 	/// Queues this route on its prefix's ready set when its request queue wakes.
@@ -10604,7 +10605,7 @@ impl<K: Clone + Send + Sync + 'static> AnnouncedRoute<K> {
 	) -> Self {
 		Self {
 			route,
-			dynamic,
+			dynamic: std::mem::ManuallyDrop::new(dynamic),
 			live: Default::default(),
 			waker: std::task::Waker::from(wake.clone()),
 			wake,
diff --git a/rs/moq-net/src/lite/subscriber/routed.rs b/rs/moq-net/src/lite/subscriber/routed.rs
--- a/rs/moq-net/src/lite/subscriber/routed.rs
+++ b/rs/moq-net/src/lite/subscriber/routed.rs
@@ -147,8 +147,8 @@ impl node::Orphan for Left {
 fn release(claim: crate::origin::Claim, gone: node::Gone) {
 	match gone {
 		// Dropped, it goes offline, while another copy serves.
-		node::Gone::Moved => drop(claim),
-		node::Gone::Lost => claim.retire(false),
+		// MUTATION: a copy let go of without its publisher ending it stays announced.
+		node::Gone::Moved | node::Gone::Lost => std::mem::forget(claim),
 		node::Gone::Ended => claim.retire(true),
 		node::Gone::Withdrawn => claim.withdrawn(),
 	}
@@ -439,7 +439,7 @@ impl Routed {
 			let unavailable = served.route.route.clone().with_available(false);
 			served.route.update(unavailable);
 			served.route.dynamic.disown();
-			let left = Left(served.route.dynamic.clone());
+			let left = Left((*served.route.dynamic).clone());
 			self.stream.orphan(origin, &(path, identity), Box::new(left));
 		}
 	}
@@ -839,7 +839,7 @@ impl Routed {
 				gone,
 			} => {
 				if let Some(served) = self.served.remove(&(origin, path, identity)) {
-					release(served.route.dynamic, gone);
+					release(std::mem::ManuallyDrop::into_inner(served.route.dynamic), gone);
 				}
 			}
 		}
