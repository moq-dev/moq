# drill: bursts_cross_a_flapping_peer::loopback
# expect: stalled with the route withdrawn
#
# Removes redialing a cluster peer whose link was lost. The edge stops driving
# its connection to the origin once the session drops, so a link flap withdraws
# the route for good: the groups caught in the flap and every burst after it
# never arrive. A steady link never drops, so only the flap drill depends on it.
diff --git a/rs/moq-relay/src/cluster.rs b/rs/moq-relay/src/cluster.rs
index 844ee1e1ba..73ee5dde72 100644
--- a/rs/moq-relay/src/cluster.rs
+++ b/rs/moq-relay/src/cluster.rs
@@ -2303,6 +2303,11 @@ impl Cluster {
 		let mut observation = monitor.state();
 		loop {
 			dial.observe(id, &observation);
+			// MUTATION: a lost peer link is never redialed.
+			if matches!(observation.phase, moq_tokio::connection::Phase::Disconnected { .. }) {
+				drop(reconnect);
+				return std::future::pending().await;
+			}
 			observation = monitor.state_changed(observation.revision).await?;
 		}
 	}
