#!/usr/bin/env just --justfile
#
# Tests that span more than one language or need a live relay. Unit tests run
# in the root `just check`.
#
# Two cross-language interop tests exist:
#   - `just test smoke` (smoke/) installs each client from its PUBLIC
#     package registry to catch packaging breakage in a release.
#   - `just test interop` (interop/, below) builds every client from THIS checkout
#     to catch interop regressions before anything is published.
# Fall back to the root justfile so `just rs test` (etc.) resolve from here.

set fallback
set working-directory := '.'

# Where cargo puts the in-tree qmux interop examples `just test qmux` runs.
qmux_examples := absolute_path(env("CARGO_TARGET_DIR", source_directory() / ".." / "target")) / "debug" / "examples"

harness_browser_tests := '''
    ./capture-channel-count.browser.ts
    ./encoded-preview.browser.ts
    ./harness.browser.ts
    ./net-cleanups.browser.ts
    ./open-gop.browser.ts
    ./publish-ui.browser.ts
    ./signals-dom.browser.ts
    ./source-selection.browser.ts
    ./tone.test.ts
    ./src/contract.test.ts
    ./src/resume.test.ts
'''

harness_compat_tests := '''
    test/interop/compat/claims.test.ts
    test/interop/compat/resolve.test.ts
'''

# List the cross-language suites.
default:
    @just --justfile {{ quote(justfile()) }} --list test

# Port isolation across private temp roots, plus Chromium checks of the watch and publish controls.
# The root devShell provides Chromium for the browser checks, which stay separate
# from plain `bun test` so unit tests do not launch a browser.
harness:
    ./lib/harness.test.sh
    ./interop/relay-log.test.sh
    python3 ../rs/moq-gst/smoke.test.py
    python3 interop/report.test.py
    python3 interop/tone.test.py
    cd .. && bun test {{ replace(harness_compat_tests, "\n", " ") }}
    cd .. && bun install --frozen-lockfile
    cd interop/clients/js && bash ../../../../sh/local.sh bun test {{ replace(harness_browser_tests, "\n", " ") }}

# Cross-language media interop test, built from this checkout. Stands up a
# relay and runs the publisher x subscriber matrix. Default: rust only (fast
# sanity check). `interop --all` runs the full matrix: rust + python + go +
# browser + C++ publish; everyone subscribes (incl. native node/bun JS, the
# moq-c C client, and the GStreamer moqsrc plugin). Other flags pass through, e.g.
# `just test interop --publishers rust,python --subscribers rust,c`.
# Finite track tails run too; `--tail` selects just the CLI FETCH close and Rust/Node/Bun tail checks.
# `--versions ietf` reruns them with every client pinned to each even moq-transport draft.
# Both runs first check the Rust/JS wire and session interop suites, in both directions.
[positional-arguments]
interop *args:
    cd .. && bun install --frozen-lockfile
    just rs test -p moq-net --lib \
        auth_unsupported_interop \
        ietf_compression_fallback_interop \
        ietf_datagram_interop \
        ietf_track_status_interop \
        ietf_range_updates_interop \
        padding_interop \
        tracks_interop \
        varint_interop \
        --run-ignored all
    ./interop/interop.sh "$@"

# The harnesses append one record per case to HARNESS_RESULTS; flags link the page to its
# workflow run. See interop/report.py.

# Render interop case records as a static HTML report.
[positional-arguments]
interop-report results out *args:
    python3 interop/report.py "$@"

# Nightly main vs newest installable registry releases: tokens, moq-lite session
# versions, decoded catalogs/containers, and group FETCH. See interop/README.md.
# --remeasure also runs the planned breaks and rewrites them, as each release does.
[positional-arguments]
wire-compat *args:
    ./interop/compat.sh "$@"

# Pinned Moxygen sections 1-7, subgroup zero, through one relay under the conformance profile.
ietf-conformance:
    ./ietf-conformance/run.sh

# Installs each client from its public registry, inside test/smoke's own Nix
# shell rather than this repo's toolchain. The first argument picks a smoke
# recipe and the rest pass through, e.g. `just test smoke full` or `just test
# smoke relays --only moq-dev-rs`. With none, the Rust-only matrix. See smoke/README.md.

# Published-package interop smoke.
[positional-arguments]
smoke *args:
    nix develop ./smoke --command just --justfile smoke/justfile "$@"

# Paint a short-side transcode rung from a coded portrait through moq-watch.
portrait:
    ./portrait/run.sh

# Negative control: no publisher, every subscriber must time out (proves the

# harness can actually report failure).
[positional-arguments]
interop-negative *args:
    ./interop/interop.sh --negative "$@"

# Browser-to-browser media QA against a deterministic fixture: presented frame progress, audible
# tone, audio/video skew, and the publication lifecycle (cold start, pause, rejoin, detach,
# republish, late join). Ends with negative controls that inject a frozen picture, silence, a
# shifted tone, and a leaked session; each must fail the assertion it names. --timeout 30 gives

# headless Chromium cold-start headroom. --media-engines selects player engines; the fixture stays Chromium.
[positional-arguments]
media *args:
    ./interop/interop.sh --media --timeout 30 "$@"

# Disrupts a real relay over real QUIC three ways: cancel a stalled reader, kill
# the relay mid-group, and republish an interrupted publisher's name. Ordinary
# tests, so `just check` runs the loopback lane whenever moq-relay is selected;
# the impaired lane is ignored there and runs nightly as `just test drill impaired`.
# This is the focused loop, both lanes. Takes a filter, e.g.
# `just test drill relay_killed`. Includes the no-publisher negative control. See
# drill/README.md.

# Transport and lifecycle failure drills.
[positional-arguments]
drill *args:
    just rs test -p moq-relay --test drills --run-ignored all "$@"

# Play through a private Linux null device using the shipped headless binary.
native-play:
    ./native-play/run.sh

# Plays a tone in headless Chromium and the native `moq play` through moq-shaper and grades
# what the listener heard (underruns, skip-aheads, silence, the resolved delay) against
# audio-quality/budgets.json. The full matrix is 24 rows at 60 s; nightly runs it with
# --enforce. Narrow it with `--profiles mild --codecs opus --runtimes chromium --duration 20`;
# `--runtimes native` is the native player alone.
# `--replays` grades only the recorded traces, in seconds, as nightly and release PRs touching the player do.
# See audio-quality/README.md.

# Grade browser and native audio playout over an impaired path.
[positional-arguments]
audio-quality *args:
    ./audio-quality/run.sh "$@"

# Records the arrival traces under audio-quality/traces/ that the replay rows grade: the
# public relay's bbb.hang, a local relay's AAC tone, and a browser microphone through the
# public relay. Needs the network. Narrow it with `--lanes relay-bbb --duration 35`.

# Re-record the audio quality arrival traces.
[positional-arguments]
audio-quality-record *args:
    ./audio-quality/record.sh "$@"

# Removes one recovery behavior at a time in a disposable copy of the tree and
# requires the drill covering it to fail, for the reason the mutation names. The
# checkout is never modified. `--list` shows the mutations.

# Prove the drills fail without the fixes they cover.
[positional-arguments]
drill-sensitivity *args:
    ./drill/sensitivity.sh "$@"

# Round-trips a PCR-paced TS through a relay and checks the subscriber's `export
# ts` output with FFmpeg, TSDuck and a custom analyzer (the T-STD buffer model, PCR
# spacing and byte schedule). Flags: `--analyze-only file.ts`
# (skip the round-trip), `--strict` (fail on shape warnings), `--source file.ts`
# (use a real capture), `--live` (grade PCR release timing and byte position off
# the pipe instead, which a capture cannot carry; nightly runs this arm),
# `--open-gop` (an open-GOP clip whose orphan leading pictures are trimmed), `--hrd`
# (1080p video filling a broadcast-sized CPB), `--mpeg2` (MPEG-2 video carried whole,
# decoded from the capture), `--delay 2s` (the exporter's). See
# ts/README.md.

# Check the subscriber's MPEG-TS output for IRD compliance.
[positional-arguments]
ts *args:
    python3 ./ts/fragment_pes.test.py
    python3 ./ts/drop_nulls.test.py
    python3 ./ts/compliance.test.py
    python3 ./ts/pcr-timing.test.py
    python3 ./ts/open-gop.test.py
    python3 ./ts/holes.test.py
    python3 ./ts/passthrough.test.py
    python3 ./ts/klv.test.py
    python3 ./ts/revision.test.py
    python3 ./ts/clockless.test.py
    ./ts/run.sh "$@"

# Carry a hardware encoder's capture, which the T-STD model passes, whole through the round-trip.
[positional-arguments]
ts-passthrough-capture *args:
    ./ts/run.sh --passthrough --source ../rs/moq-mux/src/container/ts/test_data/scte35/kyrion_dirtystart.ts "$@"

# Table-placement grader: acquisition, interleave, phase, drift and missing-table controls.
ts-pair-controls:
    python3 ./ts/table-anchor.test.py

# Round-trip the EIT fixtures: the sparse schedule must survive and
# pending-version sections must be dropped at import.
[positional-arguments]
ts-eit *args:
    ./ts/eit-roundtrip.sh "$@"

# The T-STD model's controls: a broadcast capture must pass, and the same capture
# delivered too slowly, too early, or in a burst must fail. Needs TSDuck, plus
# ffmpeg/ffprobe (libx264) for the generated references.
ts-tstd:
    bash ./ts/tstd-controls.sh

# Prove FFmpeg decode/content and TSDuck structure/PCR assertions reject damaged TS.
ts-controls:
    python3 ./ts/decode.test.py
    bash ./ts/controls.sh

# A JS viewer watching a live track through a relay that drains (SIGTERM, after
# a stand-in for DNS stops pointing at it) migrates to a second relay behind the
# same name without a dropped group. See drain/README.md.

# Relay drain migration, end to end.
drain *args:
    ./drain/run.sh {{ args }}

# Runs the @moq/wasm bindings in headless Chromium against a real relay, one per
# protocol flavour. The crate is `#![cfg(target_arch = "wasm32")]`, so nothing in
# `just check` or `just rs wasm` gets past compiling it. See wasm/README.md.

# Browser coverage for the @moq/wasm bindings.
[positional-arguments]
wasm *args:
    ./wasm/run.sh "$@"

# The @moq/video renderer in headless Chromium: WebGPU, a lost device, and the Canvas2D fallback.
video:
    cd .. && bun install --frozen-lockfile
    # A desktop display makes software Vulkan request unsupported window surfaces.
    cd video && bash ../../sh/local.sh env -u DISPLAY -u WAYLAND_DISPLAY bun test ./renderer.browser.ts

# Optional publisher retention across Rust/JS sessions through a Rust relay.
max-age:
    bash ../sh/local.sh cargo nextest run --locked -p moq-tokio --test integration -E 'test(/^max_age::/)' --run-ignored all

# A JavaScript sender exhausts each native receiver's connection credit, which recovers.
receive-credit:
    bash ../sh/local.sh cargo nextest run --locked -p moq-tokio --test integration -E 'test(/^receive_credit::javascript_/)' --run-ignored only
    bash ../sh/local.sh cargo nextest run --locked -p moq-uring --test integration -E 'test(/^receive_credit::javascript_/)' --run-ignored only

# Cross-language subscription termination over in-memory transports.
bare-fin:
    just rs test -p moq-net --lib bare_fin_interop --run-ignored all

# Explore JSON snapshot codec sequences with a fresh replayable seed.
json-properties:
    bash ../sh/local.sh bash json-properties.sh

# Check resume against its model of one logical track from a fresh replayable seed.
resume-model:
    bash ../sh/local.sh bash resume-model.sh

# The TypeScript qmux peer as client and server against the in-tree Rust qmux
# interop examples, per draft. The manifest path names the in-tree crate, which
# shares its package name with the 0.6 release its tests interoperate with.

# TypeScript-to-Rust qmux interop.
qmux:
    cargo build --locked --quiet --manifest-path ../rs/qmux/Cargo.toml --example interop-server --example interop-client
    cd .. && bun install --frozen-lockfile
    cd .. && QMUX_INTEROP_BIN={{ quote(qmux_examples) }} bun test test/qmux/interop.test.ts

# Complete MoQ SETUP and transfer a frame over a real browser data-channel pair.
p2p:
    cd .. && bun install --frozen-lockfile
    cd p2p && bash ../../sh/local.sh bun test ./transport.browser.ts

# Retain complete backend assets, parity, and raw alternating browser samples.
[positional-arguments]
wasm-baseline *args:
    HARNESS_RUNS="${HARNESS_RUNS:-../target/test/wasm-backend}" ./wasm/run.sh "$@"
    HARNESS_RUNS="${HARNESS_RUNS:-../target/test/wasm-backend}" ./wasm/run.sh --baseline "$@"
