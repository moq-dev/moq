{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		// The minted-instance tests borrow `@moq/net`'s session-only minting by relative path, so
		// the type-check spans the workspace. The build pins `rootDir` to src and skips tests.
		"rootDir": "..",
		"outDir": "dist",
		"emitDeclarationOnly": true,
		"types": ["audioworklet", "bun"]
	},
	"include": ["src", "../common/worklet.d.ts"]
}
