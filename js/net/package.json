{
	"name": "@moq/net",
	"type": "module",
	"version": "0.4.2",
	"description": "The networking layer for Media over QUIC: real-time pub/sub with built-in caching, fan-out, and prioritization.",
	"license": "(MIT OR Apache-2.0)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moq-dev/moq.git",
		"directory": "js/net"
	},
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./zod": "./src/zod.ts"
	},
	"scripts": {
		"build": "rimraf dist && tsc -b tsconfig.build.json && bun ../common/package.ts",
		"check": "tsc --noEmit && tsc -b examples/tsconfig.json && tsc --noEmit --project bench/tsconfig.json",
		"test": "bun test --only-failures",
		"release": "bun ../common/release.ts"
	},
	"dependencies": {
		"@moq/clock": "workspace:^",
		"@moq/pattern": "workspace:^",
		"@moq/qmux": "workspace:^",
		"@moq/signals": "workspace:*",
		"async-mutex": "^0.5.0",
		"pako": "^3.0.2",
		"sorted-btree": "^2.1.0",
		"uuid": "^14.0.3"
	},
	"peerDependencies": {
		"@zod/mini": "^4.5.0",
		"zod": "^4.5.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.4",
		"@typescript/lib-dom": "npm:@types/web@^0.0.358",
		"fast-check": "^4.10.2",
		"rimraf": "^6.1.3",
		"typescript": "7.0.2"
	}
}
