{
	"name": "@moq/sign",
	"type": "module",
	"version": "0.0.0",
	"description": "Per-frame Ed25519 signatures for MoQ broadcasts, so relays proxy without forging content.",
	"license": "(MIT OR Apache-2.0)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moq-dev/moq.git",
		"directory": "js/sign"
	},
	"private": true,
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
