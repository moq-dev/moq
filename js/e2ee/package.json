		"test": "bun test --only-failures"
	},
	"dependencies": {
		"@moq/net": "workspace:^"
	},
	"devDependencies": {
		"@moq/clock": "workspace:^",
		"@types/bun": "^1.4.3",
		"rimraf": "^6.1.3",
		"typescript": "7.0.2"
	}
}
