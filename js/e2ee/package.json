{
	"name": "@moq/e2ee",
	"type": "module",
	"version": "0.0.0",
	"description": "End-to-end encryption for MoQ groups, datagrams, and track names.",
	"license": "(MIT OR Apache-2.0)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moq-dev/moq.git",
		"directory": "js/e2ee"
	},
	"private": true,
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
