{
	"name": "@moq/room",
	"type": "module",
	"version": "0.1.0",
	"description": "Headless multi-participant rooms over MoQ: announce-derived roster, local publish, remote watch",
	"license": "(MIT OR Apache-2.0)",
	"repository": "github:moq-dev/moq",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "rimraf dist && tsc -b tsconfig.build.json && bun ../common/package.ts",
		"check": "tsc --noEmit",
		"test": "bun test --only-failures",
		"release": "bun ../common/release.ts"
	},
	"dependencies": {
		"@moq/hang": "workspace:^",
		"@moq/json": "workspace:^",
		"@moq/net": "workspace:^",
		"@moq/publish": "workspace:^",
		"@moq/signals": "workspace:^",
		"@moq/watch": "workspace:^"
	},
	"devDependencies": {
		"@types/audioworklet": "^0.0.100",
		"@types/bun": "^1.4.0",
		"@typescript/lib-dom": "npm:@types/web@^0.0.350",
		"rimraf": "^6.1.3",
		"typescript": "7.0.2",
		"vite": "^8.2.2"
	}
}
