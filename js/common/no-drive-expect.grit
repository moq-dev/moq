language js

// Bun's expect(...).rejects and .resolves await in a nested event loop, which breaks the order drive relies on.
or {
	`expect($call).rejects`,
	`expect($call).resolves`
} as $bad where {
	$call <: contains or {
		`$_.drive($...)`,
		`$_.driveUntil($...)`
	},
	register_diagnostic(span=$bad, message="Await drive() first, then assert on the settled result")
}
