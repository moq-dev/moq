{
	// Build-only variant of tsconfig.json that keeps tests and their fake OBS out of dist/, so they
	// are neither published nor discovered by `bun test` at the package root.
	// `tsc --noEmit` still uses tsconfig.json, so tests stay type-checked.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src"
	},
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test-util.ts"]
}
