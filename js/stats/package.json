{
	"name": "@moq/stats",
	"type": "module",
	"version": "0.0.1",
	"description": "Read a MoQ relay's published traffic stats: discover nodes and yield typed frames.",
	"license": "(MIT OR Apache-2.0)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moq-dev/moq.git",
		"directory": "js/stats"
	},
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -b tsconfig.build.json && bun ../common/package.ts",
		"check": "tsc --noEmit",
		"test": "bun test --only-failures",
		"release": "bun ../common/release.ts"
	},
	"dependencies": {
		"@moq/json": "workspace:^",
		"@moq/net": "workspace:^",
		"@moq/signals": "workspace:^",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"typescript": "7.0.2"
	}
}
