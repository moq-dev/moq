{
	"name": "@moq/hang",
	"type": "module",
	"version": "0.5.2",
	"description": "WebCodecs-based media format for MoQ",
	"license": "(MIT OR Apache-2.0)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moq-dev/moq.git",
		"directory": "js/hang"
	},
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./cmaf": "./src/cmaf/index.ts",
		"./catalog": "./src/catalog/index.ts",
		"./container": "./src/container/index.ts",
		"./util": "./src/util/index.ts"
	},
	"scripts": {
		"build": "rimraf dist && tsc -b tsconfig.build.json && bun ../common/package.ts",
		"check": "tsc --noEmit",
		"test": "bun test --only-failures",
		"release": "bun ../common/release.ts"
	},
	"dependencies": {
		"@kixelated/libavjs-webcodecs-polyfill": "^0.5.6",
		"@moq/clock": "workspace:^",
		"@moq/json": "workspace:^",
		"@moq/libav": "workspace:^",
		"@moq/loc": "workspace:^",
		"@moq/net": "workspace:^",
		"@moq/signals": "workspace:^",
		"@zod/mini": "^4.6.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "7.59.4",
		"@types/bun": "^1.4.3",
		"@typescript/lib-dom": "npm:@types/web@^0.0.358",
		"rimraf": "^6.1.3",
		"typescript": "7.0.2"
	}
}
