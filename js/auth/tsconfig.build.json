{
	// Build-only variant of tsconfig.json that keeps tests out of dist/, so they
	// are neither published nor discovered by `bun test` at the package root.
	// `tsc --noEmit` still uses tsconfig.json, so tests stay type-checked.
	//
	// insecure-test-keys.ts holds throwaway private keys for the tests. It is not
	// a test file, so it needs its own entry to stay out of a published package.
	"extends": "./tsconfig.json",
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/insecure-test-keys.ts"]
}
