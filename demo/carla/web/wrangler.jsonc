{
	// Cloudflare Wrangler configuration for the CARLA player (carla.moq.dev)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "carla-moq-dev",
	"compatibility_date": "2025-07-09",
	"account_id": "dd618f5dbd5da77b8296f1613c301f5c",
	"workers_dev": false,
	"route": {
		"pattern": "carla.moq.dev",
		"custom_domain": true
	},
	// Static assets only: the player is a Vite bundle, and unknown paths serve the page.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
