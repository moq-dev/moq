+void ASceneCaptureCamera::CloseBridge()
+{
+  if (!Bridge.IsValid())
+  {
+    return;
+  }
+  // Every queued copy holds the camera; once they have run, this is the last
+  // reference, and dropping it closes the source before freeing its slots.
+  FlushRenderingCommands();
+  Bridge.Reset();
+}
+
+bool ASceneCaptureCamera::UpdateExternalConsumer()
+{
+  if (!Bridge.IsValid())
+  {
+    return false;
+  }
+  const FString Error = Bridge->GetError();
+  if (!Error.IsEmpty())
+  {
+    // The bridge has told the worker; free the slots now rather than at
+    // destruction.
+    UE_LOG(LogCarla, Error, TEXT("MoQ bridge camera for %s stopped: %s"), *BridgeStream, *Error);
+    CloseBridge();
+    return false;
+  }
+  return Bridge->IsWanted();
+}
