+	// VK_KHR_timeline_semaphore is useless without its feature, and a plugin
+	// that enables the extension through VulkanRHIBridge has no way to add the
+	// feature to this chain itself.
+	VkPhysicalDeviceTimelineSemaphoreFeaturesKHR TimelineSemaphoreFeatures;
+	if (DeviceExtensions.ContainsByPredicate([](const ANSICHAR* Name) { return FCStringAnsi::Strcmp(Name, VK_KHR_TIMELINE_SEMAPHORE_EXTENSION_NAME) == 0; }))
+	{
+		ZeroVulkanStruct(TimelineSemaphoreFeatures, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES_KHR);
+		TimelineSemaphoreFeatures.timelineSemaphore = VK_TRUE;
+		TimelineSemaphoreFeatures.pNext = const_cast<void*>(DeviceInfo.pNext);
+		DeviceInfo.pNext = &TimelineSemaphoreFeatures;
+	}
+
