set fallback

# Run the web demo (default).
#
# Picks the first free port at/after 4443 so multiple worktrees can run
# `just dev` without colliding; see sh/demo/run.sh.
default:
    bun install
    ../sh/demo/run.sh

# Wait for the localhost relay to be ready by repeatedly requesting the cert
[positional-arguments]
[private]
wait url="http://localhost:4443/certificate.sha256":
    ../sh/demo/wait.sh "$@"

# Throttle UDP traffic for testing (macOS only, requires sudo).
throttle:
    throttle/enable
