set fallback
set shell := ["bash", "-euo", "pipefail", "-c"]

# --- R2 bucket management (vid.moq.dev) ---

# Initialize the bucket (this is mine; make your own)
init:
    bun install
    bun wrangler r2 bucket create video-moq-dev

# Deploy the worker
deploy:
    bun install
    bun wrangler deploy

# Upload a single file to R2. Fragment videos first, e.g. `ffmpeg -i input.mp4 -c copy -f mp4 -movflags cmaf+separate_moof+delay_moov+skip_trailer -frag_duration 1000 output.mp4`.
upload file:
    bun install
    bun wrangler r2 object put "video-moq-dev/{{ file }}" --file "media/{{ file }}" --remote

# Sync all files in a local directory to R2
[positional-arguments]
sync dir="media":
    ../../sh/demo/sync.sh video-moq-dev "$@"

# List files in the bucket
list:
    bun install
    bun wrangler r2 object list "video-moq-dev"

# --- Publishing ---

# Publish Big Buck Bunny to a relay server.
[positional-arguments]
bbb url='http://localhost:4443' *args:
    just download bbb
    just download bbb-sd
    cargo build --bin moq
    ffmpeg -hide_banner -loglevel warning -copyts \
        -stream_loop -1 -re -i media/bbb.mp4 \
        -stream_loop -1 -re -i media/bbb-sd.mp4 \
        -map 0 -map 1:v -c copy -f mpegts -pes_payload_size 0 - \
        | cargo run --bin moq -- "${@:2}" --connect "{{ url }}" --broadcast bbb.hang import ts

# Encode the video-only SD rendition, preserving source timestamps and loop duration.
encode-bbb-sd:
    just download bbb
    python3 bbb.py encode

# Verify the hosted rendition's frames, keyframes, and three complete loops.
check-bbb:
    just download bbb
    just download bbb-sd
    python3 bbb.py check

# Publish Tears of Steel to a relay server.
[positional-arguments]
tos url='http://localhost:4443' *args:
    just download tos
    just ts tos "$@"

# Publish a video using ffmpeg (CMAF / fMP4) to a relay server.
[positional-arguments]
cmaf name url='http://localhost:4443' *args:
    cargo build --bin moq
    just ffmpeg-cmaf "media/{{ name }}.mp4" | cargo run --bin moq -- "${@:3}" --connect "{{ url }}" --broadcast "{{ name }}.hang" import fmp4

# Publish a video using ffmpeg (MPEG-TS) to a relay server.
[positional-arguments]
ts name url='http://localhost:4443' *args:
    cargo build --bin moq
    just ffmpeg-ts "media/{{ name }}.mp4" | cargo run --bin moq -- "${@:3}" --connect "{{ url }}" --broadcast "{{ name }}.hang" import ts

# Publish a video via iroh.
iroh name url prefix="":
    just download "{{ name }}"
    cargo build --bin moq
    just ffmpeg-ts "media/{{ name }}.mp4" | cargo run --bin moq -- --iroh-enabled --connect "{{ url }}" --broadcast "{{ prefix }}{{ name }}.hang" import ts

# Generate and ingest an HLS stream from a video file.
[positional-arguments]
hls name relay="http://localhost:4443":
    just download "$1"
    ../../sh/demo/hls.sh "$@"

# Publish a video using H.264 Annex B format.
[positional-arguments]
h264 name url="http://localhost:4443" *args:
    just download "{{ name }}"
    cargo build --bin moq

    ffmpeg -hide_banner -v quiet \
    	-stream_loop -1 -re \
    	-i "media/{{ name }}.mp4" \
    	-c:v copy -an \
    	-bsf:v h264_mp4toannexb \
    	-f h264 \
    	- | cargo run --bin moq -- "${@:3}" --connect "{{ url }}" --broadcast "{{ name }}.hang" import avc3

# Publish a video using ffmpeg directly from moq to the localhost.
[positional-arguments]
serve name *args:
    just download "{{ name }}"
    cargo build --bin moq
    just ffmpeg-ts "media/{{ name }}.mp4" | cargo run --bin moq -- "${@:2}" --listen "[::]:4443" --listen-tls-generate "localhost" --auth-public "**" --broadcast "{{ name }}.hang" import ts

# Generate and serve an HLS stream from a video for testing.
[positional-arguments]
serve-hls name port="8000":
    just download "$1"
    ../../sh/demo/serve-hls.sh "$@"

# Publish the clock broadcast.
[arg("action", pattern="publish|subscribe")]
[positional-arguments]
clock action url="http://localhost:4443" *args:
    cargo run -p moq-tokio --example clock -- --connect "{{ url }}" --broadcast "clock" "${@:3}" "{{ action }}"

# --- GStreamer ---

# Publish a video using GStreamer to a relay server.
[positional-arguments]
gst name url='http://localhost:4443' *args:
    just download "{{ name }}"
    cargo build -p moq-gst

    GST_PLUGIN_PATH_1_0="${PWD}/../../target/debug${GST_PLUGIN_PATH_1_0:+:$GST_PLUGIN_PATH_1_0}" \
    gst-launch-1.0 -v -e multifilesrc location="media/{{ name }}.mp4" loop=true ! parsebin name=parse \
    	parse. ! queue ! identity sync=true ! mux.sink_0 \
    	parse. ! queue ! identity sync=true ! mux.sink_1 \
    	moqsink name=mux url="{{ url }}" broadcast="{{ name }}.hang" "${@:3}"

# --- Private helpers ---

# Download a test video (already fragmented on vid.moq.dev).
[positional-arguments]
[private]
download name:
    @../../sh/demo/download.sh "https://vid.moq.dev/$1.mp4" "media/$1.mp4"

# Convert an h264 input file to CMAF (fmp4) format to stdout, with one fragment per sample.
# -frag_duration rather than frag_every_frame: the latter repeats a fragment's tfdt when it
# interleaves audio and video, landing two samples on one timestamp.
[positional-arguments]
[private]
ffmpeg-cmaf input output='-' *args:
    ffmpeg -hide_banner -v quiet \
    	-stream_loop -1 -re \
    	-i "{{ input }}" \
    	-c copy \
    	-f mp4 -movflags cmaf+separate_moof+delay_moov+skip_trailer -frag_duration 1000 "${@:3}" "{{ output }}"

# Convert an h264 input file to MPEG-TS format to stdout, with one PES per audio frame.
[positional-arguments]
[private]
ffmpeg-ts input output='-' *args:
    ffmpeg -hide_banner -v quiet \
    	-stream_loop -1 -re \
    	-i "{{ input }}" \
    	-c copy \
    	-f mpegts -pes_payload_size 0 "${@:3}" "{{ output }}"
